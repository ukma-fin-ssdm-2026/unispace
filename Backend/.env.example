# Скопіюйте цей файл у Backend/.env і впишіть свої значення. Файл .env не комітиться.

SECRET_KEY=your_secret_key_here
DEBUG=True

# --- PostgreSQL у Docker (docker-compose.yml) ---
POSTGRES_DB=unispace
POSTGRES_USER=unispace
POSTGRES_PASSWORD=change-me

# Django підключається до бази за цим рядком. Логін, пароль і назва бази мають збігатися з POSTGRES_* вище.
# DATABASE_URL обов'язковий: міграції потребують PostgreSQL (btree_gist, ExclusionConstraint), SQLite не підтримується.
DATABASE_URL=postgresql://unispace:change-me@localhost:5432/unispace

# --- Вхід через Microsoft (Entra ID, реєстрація застосунку UniSpace) ---
# Значення: Entra -> App registrations -> UniSpace (dev) -> Overview; секрет - Certificates & secrets (поле Value).
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback/
# Відкривайте фронтенд саме на localhost (не 127.0.0.1): хост має збігатися з MS_REDIRECT_URI.
LOGIN_REDIRECT_URL=http://localhost:8001/
