@startuml
!theme plain
skinparam componentStyle uml2
skinparam roundCorner 10

skinparam package<<Frontend>> {
    BackgroundColor #EAF3FF
    BorderColor #7A9EC2
}
skinparam package<<Backend>> {
    BackgroundColor #EBF7EE
    BorderColor #76A880
}
skinparam package<<Data>> {
    BackgroundColor #FBEBF3
    BorderColor #B5849E
}

package "UniSpace" {

    package "Frontend (Client)" <<Frontend>> {
        [Client Application\n(Django UI / Templates)] as Client
        note right of Client
            Handles user interactions:
            - Schedule view (FR-006, FR-007)
            - Room filtering & selection (FR-018)
            - Re-booking & cancellation (FR-011, FR-020)
            - Conflict resolution dashboard (FR-013, FR-014)
            - In-app notification center (FR-015)
        end note
    }

    interface "REST API / Internal HTTP" as REST_API

    package "Backend (Business Logic)" <<Backend>> {
        [API Gateway & Router] as Gateway

        [Auth & User Service\n(RBAC & SSO Handler)] as AuthService
        note right of AuthService
            FR-001, FR-002, FR-003, SEC-002:
            - Microsoft OAuth2 / SSO tokens
            - User session management
            - RBAC (Student, Teacher, Dispatcher)
        end note

        [CA3 Parser Service\n(Schedule Importer)] as SyncService
        note right of SyncService
            FR-004, FR-005, A-001, REL-002:
            - HTML parser for САЗ schedule (read-only)
            - Creates default room bookings
            - Manual & periodic sync management
        end note

        [Classroom Directory Service\n(Auditorium Registry)] as RoomService
        note right of RoomService
            FR-008, FR-009, FR-018:
            - CRUD for classrooms & capacity
            - Equipment details (projectors, PCs)
            - Room filtering by features
        end note

        [Booking & Conflict Service\n(Core Engine)] as BookingService
        note right of BookingService
            FR-006, FR-007, FR-010 - FR-014, FR-020:
            - Serves active schedule data
            - Free room search & recommendation
            - Re-booking & cancellation
            - Overlap validation (REL-001)
            - Dispatcher conflict resolution (FR-014)
        end note

        [Notification Service\n(Email & In-App)] as NotificationService
        note right of NotificationService
            FR-015, FR-016, PERF-002:
            - In-app notification dispatcher
            - Sends emails on room changes (FR-015)
            - Alerts teachers on САЗ collisions (FR-016)
        end note

        [Audit Service\n(Immutable Audit Trail)] as AuditService
        note right of AuditService
            FR-017, SEC-003:
            - Append-only audit logging
            - Stores: actor, timestamp, action,
              previous/new room, reason
        end note

        [Data Access Layer\n(Django ORM)] as DAL
    }

    interface "SQL / ORM" as SQL_Interface

    package "Data Layer" <<Data>> {
        database "PostgreSQL Database\n(Data Storage)" as DB
        note right of DB
            Stores:
            - Users, profiles & roles
            - Imported CA3 raw schedule data
            - Classrooms & equipment specifications
            - Active bookings & cancellations
            - Append-only audit logs
        end note
    }
}

cloud "External Systems" {
    [CA3 System (САЗ)\n(HTML Schedule Source)] as CA3
    [Microsoft Identity Platform\n(MS SSO)] as MSSO
    [SMTP Server\n(Corporate / Test Mail)] as SMTP
}

Client --> REST_API
REST_API --> Gateway

Gateway ..> AuthService : Authentication & role checks
Gateway ..> RoomService : Room queries & CRUD
Gateway ..> BookingService : Schedule view, re-booking & conflicts (FR-014)
Gateway ..> SyncService : Trigger import (Dispatcher)
Gateway ..> AuditService : Audit log queries
Gateway ..> NotificationService : Fetch in-app notifications

BookingService ..> RoomService : Query room capacity & specs (FR-010)
BookingService ..> NotificationService : Dispatch change alerts (FR-015)
BookingService ..> AuditService : Dispatch audit record (FR-017)
SyncService ..> BookingService : Seed default bookings & detect collisions (FR-004, FR-013)
SyncService ..> NotificationService : Notify teachers on collisions (FR-016)

AuthService ..> DAL
SyncService ..> DAL
RoomService ..> DAL
BookingService ..> DAL
AuditService ..> DAL
NotificationService ..> DAL

DAL --> SQL_Interface
SQL_Interface --> DB

AuthService ..> MSSO : Validate tokens (OAuth2/OIDC)
SyncService ..> CA3 : HTTP GET / HTML Parsing (Read-Only)
NotificationService ..> SMTP : Dispatch emails (SMTP)
@enduml
