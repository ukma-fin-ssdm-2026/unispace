@startuml
!theme plain
autonumber
skinparam roundCorner 8
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Викладач" as Teacher
box "Frontend (Django Port 8001)" #EAF3FF
    participant "Client Web UI\n(Templates)" as UI
end box

box "Backend (UniSpace Core)" #EBF7EE
    participant "API Gateway / Views" as Gateway
    participant "Booking & Conflict\nService" as Booking
    participant "Audit Logging\nService" as Audit
    participant "Notification\nService" as Notif
    participant "Django ORM / DAL" as DAL
end box

box "Data Layer" #FBEBF3
    database "PostgreSQL DB" as DB
end box

box "External Systems" #FFFFFF
    participant "SMTP Server" as SMTP
end box

Teacher -> UI : Обирає нову аудиторію та підтверджує перенесення
activate UI

UI -> Gateway : POST /api/v1/bookings/{id}/change/\n{room_id, reason}
activate Gateway

Gateway -> Booking : change_booking_room(booking, new_room, reason, user)
activate Booking

group #FloralWhite Database Transaction [transaction.atomic()]
    Booking -> DAL : booking.save(update_fields=["room"])
    activate DAL

    DAL -> DB : BEGIN
    activate DB

    DAL -> DB : UPDATE bookings SET room_id = :new_room_id\nWHERE id = :booking_id
    note right of DB
      Накладкам запобігає сама база:
      ExclusionConstraint booking_active_room_time_excl
      (btree_gist) забороняє два активні бронювання
      однієї аудиторії з перетином [start, end).
      Без SELECT ... FOR UPDATE: паралельна транзакція
      чекає на індекс обмеження й отримує помилку.
    end note

    alt #LightGreen Обмеження не порушено
        DB --> DAL : row_updated

        Booking -> Audit : AuditLog.objects.create(room_changed, previous_room, new_room, reason)
        activate Audit
        Audit -> DAL : INSERT INTO audit_logs (...)
        DAL -> DB : INSERT
        Audit --> Booking : log_recorded
        deactivate Audit

        Booking -> Notif : _notify_group(booking, previous_room, new_room)
        activate Notif
        Notif -> DAL : Notification.objects.bulk_create(...) (FR-015)
        DAL -> DB : INSERT INTO notifications (...)
        Notif --> Booking : notifications_created
        deactivate Notif

        DAL -> DB : COMMIT
        DB --> DAL : transaction_committed
        deactivate DB
        DAL --> Booking : change_committed
        deactivate DAL

        Booking --> Gateway : booking
        deactivate Booking
        Gateway --> UI : 200 OK (JSON бронювання)
        deactivate Gateway
        UI --> Teacher : Відображення оновленого бронювання

    else #Pink Перетин з іншим активним бронюванням
        DB --> DAL : IntegrityError (exclusion_violation, 23P01)
        DAL -> DB : ROLLBACK
        deactivate DB
        DAL --> Booking : IntegrityError
        deactivate DAL
        note right of Booking
          IntegrityError -> BookingConflictError.
          Deadlock (40P01) і serialization failure (40001)
          при одночасних запитах теж дають 409 (REL-001).
        end note

        Booking --> Gateway : BookingConflictError
        activate Gateway
        deactivate Booking
        Gateway --> UI : 409 Conflict {"error": {"code": "CONFLICT", ...}}
        deactivate Gateway
        UI --> Teacher : Сповіщення «Аудиторія зайнята» (без помилки 500)
        deactivate UI
    end
end
@enduml
