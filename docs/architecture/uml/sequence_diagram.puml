@startuml
!theme plain
autonumber
skinparam roundCorner 8
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Викладач" as Teacher
box "Frontend (Django Port 8001)" #EAF3FF
    participant "Client Web UI\n(Templates)" as UI
end box

box "Backend (UniSpace Core)" #EBF7EE
    participant "API Gateway / Views" as Gateway
    participant "Booking & Conflict\nService" as Booking
    participant "Audit Logging\nService" as Audit
    participant "Notification\nService" as Notif
    participant "Django ORM / DAL" as DAL
end box

box "Data Layer" #FBEBF3
    database "PostgreSQL DB" as DB
end box

box "External Systems" #FFFFFF
    participant "SMTP Server" as SMTP
end box

Teacher -> UI : Обирає нову аудиторію та підтверджує перенесення
activate UI

UI -> Gateway : POST /api/v1/bookings/change\n{lesson_id, new_room_id, reason}
activate Gateway

Gateway -> Booking : changeRoom(lesson_id, new_room_id, teacher_id, reason)
activate Booking

group #FloralWhite Database Transaction [transaction.atomic()]
    Booking -> DAL : executeBookingChange(...)
    activate DAL
    
    DAL -> DB : BEGIN TRANSACTION
    activate DB

    DAL -> DB : SELECT * FROM bookings\nWHERE room_id = :new_room_id AND timeslot && :slot\nFOR UPDATE
    note right of DB
      FOR UPDATE блокує записи відразу.
      Паралельний запит чекатиме звільнення блокування.
    end note
    DB --> DAL : locked_conflicts_list
    DAL --> Booking : conflicts_count

    alt #LightGreen Аудиторія вільна (conflicts_count == 0)
        Booking -> DAL : updateRoom(booking_id, new_room_id)
        DAL -> DB : UPDATE bookings SET room_id = :new_room_id WHERE id = :booking_id
        DB --> DAL : row_updated

        Booking -> Audit : logAction(teacher_id, "ROOM_CHANGE", old_room, new_room, reason)
        activate Audit
        Audit -> DAL : insertAuditRecord(...)
        DAL -> DB : INSERT INTO audit_logs (...)
        DB --> DAL : audit_saved
        Audit --> Booking : log_recorded
        deactivate Audit

        DAL -> DB : COMMIT
        DB --> DAL : transaction_committed
        deactivate DB
        DAL --> Booking : change_committed
        deactivate DAL

        Booking -> Notif : dispatchRoomChangeAlert(lesson_id, new_room_id)
        activate Notif
        Notif ->> SMTP : Send Email to students (async)
        Notif --> Booking : notifications_queued
        deactivate Notif

        Booking --> Gateway : 200 OK {status: "success", room: new_room_id}
        deactivate Booking
        Gateway --> UI : 200 OK (JSON)
        deactivate Gateway
        UI --> Teacher : Відображення успішно оновленого розкладу

    else #Pink Виявлено накладку (conflicts_count > 0)
        Booking -> DAL : abortTransaction()
        activate DAL
        DAL -> DB : ROLLBACK
        activate DB
        DB --> DAL : transaction_rolled_back
        deactivate DB
        DAL --> Booking : rolled_back
        deactivate DAL

        Booking --> Gateway : 409 Conflict {"error": "Аудиторія зайнята іншим заняттям"}
        activate Gateway
        deactivate Booking
        Gateway --> UI : 409 Conflict
        deactivate Gateway
        UI --> Teacher : Валідаційне сповіщення: "Аудиторія зайнята" (без помилки 500)
        deactivate UI
    end
end
@enduml
